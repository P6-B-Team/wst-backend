# ---- runtime ----
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000          # used in the OpenAPI servers block and certificate QR codes

# ---- database ----
DATABASE_URL=postgres://wst:wst@localhost:5432/wst
PG_POOL_MAX=20

# ---- authentication ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Encrypts the certificate verification token so an authorised caller can re-render the QR
# code. Losing this key costs re-rendering only; public verification keeps working.
CERT_TOKEN_KEY=change-me-certificate-token-key-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- web ----
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_AUTH=30                        # requests per minute per IP on /api/v1/auth
RATE_LIMIT_API=600                        # requests per minute per IP on the rest of /api/v1
RATE_LIMIT_DISABLED=false                 # automatically disabled when NODE_ENV=test

# ---- optional AI service (WST-FR-14) ----
# Leave empty to run on the deterministic rule baselines. When set, predictions call the service and
# fall back to the baselines on timeout or error, reporting meta.fallbackUsed=true.
AI_SERVICE_URL=
AI_TIMEOUT_MS=1500

# Tax rate, purchase-approval thresholds, reminder intervals and certification minimums are NOT
# environment variables: they live per organization in the org_settings table and are editable
# through GET/PATCH /api/v1/settings.
