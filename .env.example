# ---- runtime ----
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000

# ---- database ----
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@localhost:5432/wst
PG_POOL_MAX=20

# ---- authentication ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
CERT_TOKEN_KEY=change-me-certificate-token-key-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- web ----
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_AUTH=30
RATE_LIMIT_API=600
RATE_LIMIT_DISABLED=false

# ---- optional AI service (WST-FR-14) ----
AI_SERVICE_URL=https://ai-part-07er.onrender.com
AI_TIMEOUT_MS=8000
AI_SERVICE_TOKEN=

# Tax rate, purchase-approval thresholds, reminder intervals and certification minimums
# are NOT environment variables: they live per organization in the org_settings table
# and are editable through GET/PATCH /api/v1/settings.
